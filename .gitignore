# .gitignore — ignore local scripts, test output, caches, and editor/runtime artifacts

# Node dependencies
node_modules/

# Local env / secrets
.env
.env.*.local
env.local

# Project scripts and local test output
scripts/
test-output/
external/

# Local data caches and generated artifacts
data/
apify_storage/
.cache/
*.cache

# Logs and temp files
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log
logs/
tmp/
temp/
*.tmp

# Test coverage
coverage/
.nyc_output/
test-results/

# Playwright artifacts
playwright-report/
playwright/.auth/

# Build outputs
dist/
build/

# Editor / OS files
.vscode/
.idea/
.history/
.DS_Store
Thumbs.db
*.swp
*.swo

# TypeScript
*.tsbuildinfo
# Node & package artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local environment files (do NOT commit)
.env
.env.local
.env.*.local
!.env.example

# OS files
.DS_Store
Thumbs.db

# Logs
logs
*.log

# Build / cache
dist/
build/
.cache/
coverage/
.nyc_output/

# IDE / editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Test output / development helpers
test-output/
scripts/
data/

# Temporary
tmp/
*.tmp
